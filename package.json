{
  "name": "lossless-url-compressor",
  "version": "1.0.0",
  "description": "WIP spec for a stateless, deterministic, lossless URL compressor for `https://l.mia.cx/`.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "worker:dev": "pnpm build && wrangler dev",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "train:headers:scan": "node scripts/analyze-commoncrawl-headers.mjs",
    "train:headers:optimize": "tsx scripts/optimize-header-tables.ts",
    "train:messaging:shards": "tsx scripts/run-messaging-shards.ts",
    "train:reports": "cargo run --release --manifest-path tools/urltrainer/Cargo.toml -- report",
    "train:tokenizer:base": "tsx scripts/train-v2-tokenizer.ts data/training/full-2026-08-18/reports && tsx scripts/generate-v2-codec-model.ts data/training/full-2026-08-18/reports",
    "train:tokenizer": "pnpm train:tokenizer:base && pnpm train:tokenizer:huffman",
    "train:tokenizer:huffman": "tsx scripts/train-v2-huffman.ts data/training/full-2026-08-18/reports && tsx scripts/generate-v2-codec-model.ts data/training/full-2026-08-18/reports",
    "train:tokenizer:benchmark": "tsx scripts/benchmark-v2-tokenizer.ts data/training/full-2026-08-18/reports",
    "train:codec:model": "tsx scripts/generate-v2-codec-model.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260529.1",
    "@types/node": "^25.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  },
  "dependencies": {
    "hono": "^4.12.23"
  }
}
